# PostgreSQL Database Configuration
BACKEND_POSTGRES_HOST=localhost
BACKEND_POSTGRES_PORT=5432
BACKEND_POSTGRES_DB=db
BACKEND_POSTGRES_USER=username
BACKEND_POSTGRES_PASSWORD=password

# Security
BACKEND_SECRET_KEY=your_secret_key_here

# Spotify API Configuration
BACKEND_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
BACKEND_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
BACKEND_SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback
BACKEND_SPOTIFY_REFRESH_TOKEN_TTL=5184000
BACKEND_ACCESS_TOKEN_EXP=3600
BACKEND_REFRESH_TOKEN_EXP=604800

# Redis Configuration
BACKEND_REDIS_HOST=localhost
BACKEND_REDIS_PORT=6379
BACKEND_REDIS_DB=0
# BACKEND_REDIS_PASSWORD=your_redis_password_here  # Optional

# Logging Configuration
BACKEND_LOG_LEVEL=INFO

# Database Engine Configuration
BACKEND_DB_ECHO=false
BACKEND_DB_POOL_SIZE=10
BACKEND_DB_MAX_OVERFLOW=20

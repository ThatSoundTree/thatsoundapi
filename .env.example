BACKEND_POSTGRES_HOST=localhost
BACKEND_POSTGRES_PORT=5432
BACKEND_POSTGRES_DB=postgres
BACKEND_POSTGRES_USER=postgres
BACKEND_POSTGRES_PASSWORD=your_postgres_password

# Ключ для хэширования telegram_id в htelegram_id
# ДОЛЖЕН СОВПАДАТЬ с TELEGRAM_BOT_TELEGRAM_HASH_KEY в thatsoundbot!
BACKEND_TELEGRAM_HASH_KEY=your_telegram_hash_key_here

# Bearer токен для авторизации в thatsounddirect API
# ДОЛЖЕН СОВПАДАТЬ с DDS_AUTH_KEY в thatsounddirect!
BACKEND_TO_DIRECT_AUTH_KEY=your-to-direct-auth-key-here
BACKEND_TSDIRECT_API_BASE_URL=https://api.tsdirect.com
BACKEND_AUTH_KEY=something
# Spotify API credentials
BACKEND_SPOTIFY_CLIENT_ID=your_spotify_client_id
BACKEND_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
BACKEND_SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/spotify/callback
BACKEND_SPOTIFY_REFRESH_TOKEN_TTL=5184000
BACKEND_SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
BACKEND_SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
BACKEND_SPOTIFY_AUTHORIZE_URL=https://accounts.spotify.com/authorize
BACKEND_SPOTIFY_SCOPES=user-read-recently-played streaming
BACKEND_SPOTIFY_OAUTH_STATE_TTL=600
BACKEND_ACCESS_TOKEN_EXP=3600
BACKEND_REFRESH_TOKEN_EXP=604800

# Redis Configuration
BACKEND_REDIS_HOST=localhost
BACKEND_REDIS_PORT=6379
BACKEND_REDIS_DB=0

# Logging Configuration
BACKEND_LOG_LEVEL=INFO
BACKEND_DB_ECHO=false
BACKEND_DB_POOL_SIZE=10
BACKEND_DB_MAX_OVERFLOW=20
